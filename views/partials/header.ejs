
<div class="head-container">
    <p id="header-text"></p>
</div>
<script>
    let i = 0;
    const text = "Blog Web Application using Express js with Node js.";
    const speed = 100;
    function typeWriter () {
        if (i < text.length) {
            document.getElementById("header-text").innerHTML += text.charAt(i);
            i++;
            setTimeout(typeWriter, speed);
        };
    };
    window.onload = typeWriter;
</script>