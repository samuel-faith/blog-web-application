<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog Web Application</title>
</head>
<body>
    <div class="container">
        <h1> Welcome to my Blog Posts</h1>
        <a href="/create"> New Post</a>

        <% if (posts.length === 0) { %>
            <p>No posts yet. Create one!</p>
       <% } else{%>
            <% posts.forEach(post => { %>
                <div class= "post">
                    <h2> <%= post.title%></h2>
                    <p> <%= post.content%></p>
                    <div class= "post-actions">
                        <a href="/edit/<%= post.id %>" class="btn-samll">Edit</a>
                        <form action="/delete/<%= post.id %>" method="POST">
                            <button type="submit" value="delete" class="btn-small delete">Delete Post</button>
                        </form>
                    </div>
                </div>
          <%  }); %>
            
       <% } %>
    </div>
</body>
</html>