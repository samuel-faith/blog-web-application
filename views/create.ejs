<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/css/styles.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Belleza&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    <title>Create Posts</title>
</head>
<body>
    <%- include("partials/header.ejs") %>
    <div class="cont">
        <div class="container">
            <h2>Create a new post</h2>
            <%# Creating a new post%>
            <form action="/create" method="POST">
                <input type="text" name="title" placeholder="Post title goes in here..." required>
                <textarea name="content" placeholder="What is your post all about?" required></textarea>
                <button type="submit" value="Post" class="btn">Post</button>
            </form>
            <a href="/" class="btn-small">See all posts</a>
        </div>
    </div>
    <%- include("partials/footer.ejs") %>
</body>
</html>